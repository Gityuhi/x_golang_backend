# --- PostgreSQL Database ---
# ローカルのDocker開発環境で使用するユーザー名
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db

# --- Application ---
# アプリケーションが動作するベースURL（例: http://localhost:8081）
URL=http://localhost:8081

# --- JWT Authentication ---
# 32文字以上のランダムな文字列を推奨
JWT_SECRET_KEY=your-super-secret-jwt-key-for-development